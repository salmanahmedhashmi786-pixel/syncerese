{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syncrese",
  "version": "1.0.0",
  "identifier": "com.syncrese.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "shell",
        "title": "Syncr\u00e8se",
        "width": 520,
        "height": 620,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https:",
      "capabilities": [
        "shell-window"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/icon.ico",
      "../icons/icon.png"
    ],
    "publisher": "Syncrese",
    "shortDescription": "ERP for small and medium business",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": {
      "../sidecar/": "sidecar/"
    }
  }
}
