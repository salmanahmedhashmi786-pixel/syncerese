{
  "name": "syncrese",
  "version": "1.0.0",
  "private": true,
  "description": "Syncrese - multi-tenant ERP for SMEs",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:provision": "tsx scripts/provision-db.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "env:check": "tsx scripts/check-env.ts",
    "gen:secrets": "tsx scripts/gen-secrets.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('.syncrese-dev',{recursive:true,force:true})\" && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:platform-seed": "tsx scripts/gen-platform-seed.ts",
    "dev:key": "tsx scripts/issue-dev-key.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.4",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^8.0.11",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.5.0",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
