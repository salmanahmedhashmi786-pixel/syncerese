# Syncrese — environment template.
# Copy to `.env.local` and fill in. NEVER commit the filled-in file (.gitignore covers it).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The APPLICATION connection. This role must NOT be the table owner and must NOT
# have BYPASSRLS — tenant isolation depends on it. See drizzle/0001_rls.sql.
DATABASE_URL="postgresql://syncrese_app:CHANGEME@localhost:5432/syncrese?sslmode=require"

# The MIGRATION connection (table owner). Used only by `npm run db:migrate`.
# Kept separate so the running application can never alter schema or policies.
DATABASE_MIGRATION_URL="postgresql://syncrese_owner:CHANGEME@localhost:5432/syncrese?sslmode=require"

# Role the app switches to per transaction. Leave EMPTY in production when the
# connection already authenticates as the app role. Tests set this to switch off
# the superuser that would otherwise bypass RLS entirely.
DB_APP_ROLE=""

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET="CHANGEME"
AUTH_URL="http://localhost:3000"

# Whether this installation creates new organizations from the public internet.
#   open   — public SaaS signup at /sign-up
#   closed — new members arrive only by invitation (the default, and the right
#            answer for a self-hosted instance)
SIGNUP_MODE="closed"

# Set to "false" when the app is exposed DIRECTLY to the internet with no proxy
# in front of it. x-forwarded-for is client-controlled unless something trusted
# sets it, and believing it lets one caller wear a new address per request —
# which defeats the signup throttle entirely.
TRUST_PROXY_HEADERS="true"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID — most SME buyers are Microsoft 365 shops
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# ---------------------------------------------------------------------------
# Crypto
# ---------------------------------------------------------------------------
# Encrypts integration OAuth tokens and MFA secrets at rest (§13/§1 of the schema).
# 32 bytes, base64. Rotate via ENCRYPTION_KEY_PREVIOUS.
ENCRYPTION_KEY="CHANGEME"
ENCRYPTION_KEY_PREVIOUS=""

# ---------------------------------------------------------------------------
# Licensing (phase 8)
# ---------------------------------------------------------------------------
LICENSE_KEY_PEPPER="CHANGEME"

# ---------------------------------------------------------------------------
# Billing (Stripe)
# ---------------------------------------------------------------------------
# Leave EMPTY to run without billing — every tenant then stays on whatever
# licence it was provisioned with, and the billing panel says so plainly. That
# is the normal arrangement for a self-hosted install.
#
# sk_test_… while you are setting up, sk_live_… when you mean it. A live key on
# a staging deployment charges real cards.
STRIPE_SECRET_KEY=""

# From the webhook endpoint you create in Stripe, pointing at
# https://your-host/api/webhooks/stripe — NOT your API key. This is the only
# thing authenticating that endpoint, and the endpoint grants entitlements.
STRIPE_WEBHOOK_SECRET=""

# Stripe Price ids, one per plan. Recurring, per seat. A plan with no price id
# is hidden rather than offered and then failing at checkout.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_ENTERPRISE=""

# ---------------------------------------------------------------------------
# AI assistant — server-side only, never exposed to the client
#
# OPTIONAL. Left blank, the assistant answers a fixed set of questions by
# matching keywords to a lookup and rendering the rows itself — no outbound
# call, no data leaving the deployment, and no way for it to state a figure it
# did not retrieve. That is a supported way to run this, not a degraded one.
#
# Set it and the user's question, the tool definitions and the retrieved rows
# are sent to Anthropic. Those rows are the tenant's business data. See
# docs/08-assistant.md.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# ---------------------------------------------------------------------------
# Email — password resets and invitations
#
# OPTIONAL, but a deployment without it has no self-service password reset:
# a user who forgets their password cannot get back in on their own.
#
# SMTP reaches every managed provider (Resend, Postmark, SES, Mailgun,
# SendGrid) as well as a self-hosted relay, so there is one code path rather
# than one per vendor. Port 465 is implicit TLS; 587 upgrades and is required
# to do so, rather than silently falling back to clear text.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
