# Syncrese — self-hosted deployment (docker compose).
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# .env.docker is gitignored. Nothing in it belongs in source control.
#
# Generate every secret below with:
#   openssl rand -base64 32

# --- database passwords ----------------------------------------------------
# Three distinct roles, three distinct passwords. Reusing one across them
# throws away the separation that keeps a compromised app process from being
# able to drop an RLS policy.
POSTGRES_PASSWORD=
SYNCRESE_OWNER_PASSWORD=
SYNCRESE_APP_PASSWORD=

# --- application -----------------------------------------------------------
# Signs session tokens. Changing it signs everyone out; losing it means nobody
# can sign in until it is replaced. Back it up with the database.
AUTH_SECRET=

# The public URL, exactly as browsers reach it, including scheme. Session
# cookies and OAuth callbacks are built from this.
AUTH_URL=https://erp.example.com

# Encrypts integration tokens and MFA secrets at rest. 32 bytes, base64.
# THIS ONE IS NOT RECOVERABLE: lose it and the data it protects is gone.
ENCRYPTION_KEY=

# Peppers API-key and webhook-secret hashes. Must be set before the first key
# is issued — changing it later invalidates every key already handed out.
LICENSE_KEY_PEPPER=

# Authenticates the webhook dispatch tick. Leave empty to run without webhook
# delivery; set it and start with `--profile webhooks` to enable.
CRON_SECRET=

# open   — anyone can create an organization at /sign-up
# closed — new members arrive by invitation only (correct for most self-hosts)
#
# A self-hosted instance normally sets this to "open" JUST LONG ENOUGH to
# create the first organization, then back to "closed" and restarts.
SIGNUP_MODE=closed

# Host port. The container always listens on 3000 internally.
APP_PORT=3000
